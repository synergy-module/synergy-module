# Synergy Module: Discord is required for local, beta, and production sign-in.
AUTH_MODE=discord
SESSION_SECRET=replace-with-a-long-random-secret
# Keep this stable across deployments. If blank, saved AI keys use SESSION_SECRET.
# Use a separate long random value to rotate login secrets without re-entering AI keys.
INTEGRATIONS_ENCRYPTION_KEY=
# Local development only; production uses DATABASE_URL. Persist this data directory.
WORKSPACE_DB_PATH=data/workspace.sqlite
DATABASE_URL=
DATABASE_SSL=disable
DATABASE_POOL_MAX=10
DATABASE_CONNECT_TIMEOUT_MS=5000
DATABASE_STATEMENT_TIMEOUT_MS=10000
DATABASE_LOCK_TIMEOUT_MS=3000

# Discord OAuth2 application and server configuration.
# Keep the client secret private and never commit a populated value.
DISCORD_ACCESS_POLICY=site-roles
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI=http://127.0.0.1:3000/auth/discord/callback
DISCORD_GUILD_ID=1554634103997861889
# Required site membership: SynergyModule. Administration additionally requires SMA*.
DISCORD_REQUIRED_ROLE_ID=1554903899343814857
DISCORD_ROLE_ADMIN_ID=1557751441693736991
# The remaining mappings are used only by the legacy roles policy.
DISCORD_ROLE_DEVELOPER_ID=
DISCORD_ROLE_OS_ID=
DISCORD_ROLE_INDICATORS_ID=
DISCORD_ROLE_JOURNAL_ID=
DISCORD_ROLE_REFRESH_MINUTES=1

# Local server address used by npm start.
HOST=127.0.0.1
PORT=3000

# The public Economicium calendar requires no account or API key.

# Agentic Trader: optional server-only AI credentials. Never commit populated keys.
# Gemini is the default; the workspace also supports OpenAI and Claude.
TRADER_AI_PROVIDER=gemini
# Keep false while building offline. Keys alone never enable paid AI requests.
TRADER_PAID_AI_ENABLED=false
# Robinhood official Trading MCP. Use a distinct 32-byte encryption key (64 hex characters).
# Callback defaults to /auth/robinhood/callback on DISCORD_REDIRECT_URI's origin.
ROBINHOOD_TOKEN_ENCRYPTION_KEY=
ROBINHOOD_REDIRECT_URI=
# Optional public OAuth client issued by Robinhood for this exact callback; leave blank for dynamic registration.
ROBINHOOD_CLIENT_ID=
ROBINHOOD_LIVE_TRADING_ENABLED=false
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# Optional model overrides; leave blank to use the application's defaults.
GEMINI_MODEL=
OPENAI_MODEL=
ANTHROPIC_MODEL=

# Agent Brain pricing: optional USD per million tokens for the configured models.
# Needed for dollar caps; unknown prices remain unknown in the UI.
BRAIN_DB_PATH=data/agent-brain.sqlite
BRAIN_GEMINI_INPUT_USD_PER_MILLION=
BRAIN_GEMINI_OUTPUT_USD_PER_MILLION=
BRAIN_GEMINI_CACHED_INPUT_USD_PER_MILLION=
BRAIN_GEMINI_CACHE_CREATION_INPUT_USD_PER_MILLION=
BRAIN_OPENAI_INPUT_USD_PER_MILLION=
BRAIN_OPENAI_OUTPUT_USD_PER_MILLION=
BRAIN_OPENAI_CACHED_INPUT_USD_PER_MILLION=
BRAIN_OPENAI_CACHE_CREATION_INPUT_USD_PER_MILLION=
BRAIN_CLAUDE_INPUT_USD_PER_MILLION=
BRAIN_CLAUDE_OUTPUT_USD_PER_MILLION=
BRAIN_CLAUDE_CACHED_INPUT_USD_PER_MILLION=
BRAIN_CLAUDE_CACHE_CREATION_INPUT_USD_PER_MILLION=
