# Import through StayLively server Settings; fill in private values there.
# Keep populated configuration out of Git and Docker images.
APP_ENVIRONMENT=beta
AUTH_MODE=discord
SESSION_SECRET=
# Preserve the previous deployment's stable encryption key, when configured.
# If blank, saved provider credentials use SESSION_SECRET instead.
INTEGRATIONS_ENCRYPTION_KEY=
DATABASE_SSL=disable
# Dedicated read-only connection to the synergy-mcp research views.
SYNERGY_RESEARCH_DATABASE_URL=
SYNERGY_RESEARCH_DATABASE_SSL=disable
APP_ALLOW_MIGRATIONS=false

# Connect the existing PostgreSQL database through StayLively's database panel.
# The connection supplies DATABASE_URL; do not overwrite its managed value.

# Only SynergyModule role holders in the SynergyModule server can enter.
# SMA* additionally grants administration. Membership alone never grants Admin.
DISCORD_ACCESS_POLICY=site-roles
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_GUILD_ID=1554634103997861889
DISCORD_REQUIRED_ROLE_ID=1554903899343814857
DISCORD_REDIRECT_URI=https://synergymodule.dev/auth/discord/callback
DISCORD_ROLE_DEVELOPER_ID=
DISCORD_ROLE_ADMIN_ID=1557751441693736991
DISCORD_ROLE_OS_ID=
DISCORD_ROLE_INDICATORS_ID=
DISCORD_ROLE_JOURNAL_ID=
DISCORD_ROLE_REFRESH_MINUTES=1

# Preserve this key if restoring existing encrypted Robinhood tokens.
ROBINHOOD_TOKEN_ENCRYPTION_KEY=
ROBINHOOD_LIVE_TRADING_ENABLED=false
TRADER_PAID_AI_ENABLED=false
