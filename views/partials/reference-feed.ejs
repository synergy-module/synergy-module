<section class="connection-card reference-feed-card" data-reference-feed>
  <div class="connection-card-heading"><span class="provider-mark" aria-hidden="true">↝</span><div><h3>Polymarket reference prices</h3><p>Optional · International PolyBolt data feed</p></div><span class="connection-state" data-reference-status>Not checked</span></div>
  <p>Record current reference prices and one-minute TWAP observations for crypto prediction research. These data credentials are separate from your Polymarket US account and never place orders.</p>
  <% if (referenceMode === 'settings') { %>
  <form data-reference-credentials><details><summary>Connect international data credentials</summary><div class="settings-fields"><label class="field">API key<input name="apiKey" type="password" maxlength="4096" autocomplete="new-password" required></label><label class="field">Secret<input name="secret" type="password" maxlength="4096" autocomplete="new-password" required></label><label class="field">Passphrase<input name="passphrase" type="password" maxlength="4096" autocomplete="new-password" required></label></div><div class="workspace-actions"><button class="btn" type="submit" disabled>Save encrypted credentials</button><button class="text-action" type="button" data-reference-disconnect disabled>Disconnect</button></div><p class="practice-help">Saving credentials does not verify access. Start an optional recording in Practice to check the feed.</p></details></form>
  <a class="btn" href="/practice?view=data" data-nav-link>Open reference recorder ↗</a>
  <% } else { %>
  <a href="/settings?section=connections" data-nav-link>Manage optional data credentials ↗</a>
  <form data-reference-recorder><div class="practice-form-grid"><label class="field">Reference symbol<select name="symbol"><option value="btcusd">Bitcoin / USD</option><option value="ethusd">Ethereum / USD</option><option value="solusd">Solana / USD</option><option value="xrpusd">XRP / USD</option></select></label><label class="field">Recording duration<select name="durationSeconds"><option value="300">5 minutes</option><option value="900" selected>15 minutes</option><option value="3600">1 hour</option></select></label></div><p class="practice-help">Records price and one-minute TWAP channels. Gaps and stale samples remain visible; a recording starts only when you choose Start.</p><div class="workspace-actions"><button class="btn" type="submit" disabled>Start recording</button><button class="btn" type="button" data-reference-stop disabled>Stop recording</button><button class="btn" type="button" data-reference-snapshot>View recorded evidence</button></div></form>
  <div data-reference-evidence hidden><p data-reference-summary></p><button class="btn" type="button" data-reference-export>Download recorded evidence</button><details><summary>Inspect timestamped samples</summary><pre data-reference-json></pre></details></div>
  <% } %>
  <p class="provider-feedback" data-reference-feedback role="status">Open this section to check feed access.</p>
</section>
