<aside class="sidebar" data-sidebar>
  <a class="cortex-brand workspace-brand" href="/home" data-nav-link aria-label="Synergy Module home"><img class="cortex-brand-mark" src="<%= assetPath('/assets/synergy-module-mark.svg') %>" alt="" width="40" height="40"><b class="cortex-brand-name">SYNERGY</b><span>MODULE</span><small>YOUR MARKET WORKSPACE</small></a>
  <nav aria-label="Workspace navigation" class="workspace-navigation">
    <% let previousGroup = ''; const groups = { 'robinhood-brain': 'live', 'robinhood-paper': 'practice', 'polymarket-paper': 'practice', 'polymarket-account': 'live', 'journal-new': 'journal', 'journal-public': 'journal' }; %>
    <% page.navigation.forEach((item) => { const group = item.group || 'Administration'; const active = item.key === (groups[page.route.key] || page.route.key); %>
      <% if (group !== previousGroup) { previousGroup = group; %><p class="navigation-group" data-navigation-group="<%= group %>"><span><%= group %></span><% if (group === 'Practice') { %><small>VIRTUAL</small><% } else if (group === 'Live trading') { %><small>REAL FUNDS</small><% } %></p><% } %>
      <a class="navitem<%= active ? ' active' : '' %>" href="<%= item.path %>" data-nav-link data-nav-key="<%= item.key %>" data-required-capability="<%= item.capability %>"<% if (active) { %> aria-current="page"<% } %> title="<%= item.hint || item.description %>"><span class="cortex-nav-index" aria-hidden="true"><%= ({home:'⌂',brain:'◈',research:'⌕',polymarket:'%',practice:'◇',live:'↗',accounts:'▣',journal:'▤',settings:'⚙',admin:'◆','market-news':'▦'})[item.key] || '·' %></span><span class="navigation-label"><%= item.label || item.title %><small><%= item.hint || '' %></small></span></a>
    <% }) %>
  </nav>
  <div class="sidebar-foot">
    <% if (typeof designPreview !== 'undefined' && designPreview) { %><span class="cortex-preview">ISOLATED DESIGN PREVIEW</span><% } %>
    <div class="cortex-theme" role="group" aria-label="Color theme"><button type="button" data-color-theme="dark" aria-pressed="false">Dark</button><button type="button" data-color-theme="light" aria-pressed="false">Light</button><button type="button" data-color-theme="system" aria-pressed="true">Auto</button></div>
    <a class="sidebar-profile" href="/settings?section=profile" data-nav-link><span class="cortex-nav-label">YOUR ACCOUNT</span><strong class="cortex-operator" data-display-name><%= (typeof workspaceExperience !== 'undefined' && workspaceExperience?.profile?.displayName) || page.operator?.displayName || page.operator?.username || 'Operator' %></strong></a>
    <button class="btn sidebar-logout" type="button" data-logout>Sign out ↗</button>
  </div>
</aside>
