<% const paperWorkspace = typeof page !== 'undefined' && page.route?.key === 'robinhood-paper'; %>
<section class="route poly-page rh-page" data-robinhood-brain data-rh-environment="<%= paperWorkspace ? 'paper' : 'live' %>" data-route-view data-route-key="<%= paperWorkspace ? 'robinhood-paper' : 'robinhood-brain' %>" aria-label="<%= paperWorkspace ? 'Equity paper trading' : 'Live equity trading' %>">
  <header class="poly-heading"><div><h1><%= paperWorkspace ? 'Equity paper trading' : 'Live equity trading' %></h1><p><%= paperWorkspace ? 'Current broker market data · Virtual orders in a separate paper account' : 'Connected brokerage accounts · Real orders with your chosen authorization' %></p></div><span class="poly-mode" data-rh-mode><%= paperWorkspace ? 'VIRTUAL FUNDS' : 'REAL ACCOUNTS' %></span></header>
  <div class="workspace-tabs" role="tablist" aria-label="Robinhood Brain">
    <% for (const [key,label] of [['mission','Mission'],['execution','Execution'],['memory','Memory'],['policy','Policy & providers']]) { %>
      <button type="button" id="rh-tab-<%= key %>" role="tab" aria-controls="rh-panel-<%= key %>" aria-selected="<%= key === 'mission' %>" tabindex="<%= key === 'mission' ? 0 : -1 %>" data-rh-tab="<%= key %>"><%= label %></button>
    <% } %>
  </div>
  <p class="poly-feedback" role="status" data-rh-feedback>Loading Robinhood Brain...</p>
  <section id="rh-panel-mission" role="tabpanel" aria-labelledby="rh-tab-mission" data-rh-panel="mission">
    <div class="rh-mission-tools"><span data-rh-routing>Checking providers...</span><div class="workspace-actions"><button type="button" class="btn primary" data-rh-action="cycle" <%= paperWorkspace ? '' : 'hidden' %> disabled>Observe live prices &amp; paper trade</button><a class="btn" href="<%= paperWorkspace ? '/practice' : '/accounts' %>" data-nav-link><%= paperWorkspace ? 'Paper accounts' : 'Accounts & approvals' %> ↗</a></div></div>
    <ol class="poly-pipeline" aria-label="Trading phases"><li><b>A1</b> Observe</li><li><b>A2</b> Research &amp; critique</li><li><b>B1</b> Refresh &amp; risk</li><li><b>B2</b> Execute &amp; reconcile</li></ol>
    <div class="rh-mission-grid"><section><div class="poly-section-heading"><h2>Latest cycle</h2><span data-rh-phase>NO CYCLE</span></div><div data-rh-run><p class="poly-muted">No saved cycle.</p></div></section><aside><div class="poly-section-heading"><h2>Readiness</h2><a href="/settings?section=connections" data-nav-link>Connections</a></div><ul class="poly-checks" data-rh-readiness></ul><div class="poly-section-heading"><h3>Cycle history</h3></div><div data-rh-history></div></aside></div>
  </section>
  <section id="rh-panel-execution" role="tabpanel" aria-labelledby="rh-tab-execution" data-rh-panel="execution" hidden>
    <div class="poly-section-heading"><h2>Execution</h2><span data-rh-worker>CHECKING WORKER</span></div>
    <div class="rh-execution-modes" role="radiogroup" aria-label="Execution mode"><% if (paperWorkspace) { %><label><input type="radio" name="rh-mode" value="paper" checked> Forward paper trading · virtual funds</label><% } else { %><label><input type="radio" name="rh-mode" value="review" checked> Review each real order</label><label><input type="radio" name="rh-mode" value="autonomous"> Autonomous live trading</label><% } %></div>
    <label class="rh-consent" data-rh-consent-label hidden><input type="checkbox" data-rh-consent> Authorize equity orders in this account and symbol allowlist, within the displayed policy, without asking before each order.</label>
    <p class="poly-model-note" data-rh-authority></p>
    <div class="workspace-actions"><button type="button" class="btn primary" data-rh-action="start" disabled><%= paperWorkspace ? 'Start paper observations' : 'Start live worker' %></button><button type="button" class="btn" data-rh-action="pause" disabled>Pause immediately</button><button type="button" class="btn" data-rh-action="reconcile" <%= paperWorkspace ? 'hidden' : '' %> disabled>Reconcile orders</button><% if (!paperWorkspace) { %><a href="/accounts" data-nav-link>Broker approvals &amp; activity</a><% } %></div>
    <dl class="poly-stats" data-rh-stats <%= paperWorkspace ? '' : 'hidden' %>></dl>
    <div class="poly-section-heading"><h3>Order ledger</h3><span>ACKNOWLEDGEMENT IS NOT A FILL</span></div><div class="poly-table-scroll"><table class="poly-table"><thead><tr><th>Order</th><th>Shares / limit</th><th>Mode / status</th><th>Reason</th><th>Time</th></tr></thead><tbody data-rh-ledger></tbody></table></div>
  </section>
  <section id="rh-panel-memory" role="tabpanel" aria-labelledby="rh-tab-memory" data-rh-panel="memory" hidden>
    <div class="poly-brain-layout"><section><div class="poly-section-heading"><h2>Operator lessons</h2><span data-rh-storage></span></div><form data-rh-note-form><label class="field">Lesson<textarea name="text" rows="4" required maxlength="1500"></textarea></label><button type="submit" class="btn primary">Save lesson</button></form><div data-rh-notes></div></section><section><div class="poly-section-heading"><h2>Research memory</h2><span>LAST 20</span></div><div data-rh-memories></div></section></div>
  </section>
  <section id="rh-panel-policy" role="tabpanel" aria-labelledby="rh-tab-policy" data-rh-panel="policy" hidden>
    <form data-rh-policy-form>
      <div class="poly-section-heading"><h2>AI routing</h2><a href="/settings?section=connections" data-nav-link>Provider credentials</a></div>
      <div class="poly-settings-grid"><% for (const [key,label] of [['provider','Research provider'],['criticProvider','Independent review provider']]) { %><label class="field"><%= label %><select name="<%= key %>"><% for (const [id,name] of [['claude','Claude'],['gemini','Gemini'],['grok','Grok'],['openai','ChatGPT / Codex (OpenAI API)']]) { %><option value="<%= id %>"><%= name %></option><% } %></select></label><% } %></div>
      <p class="poly-model-note">ChatGPT / Codex uses your OpenAI API connection. A ChatGPT subscription does not supply this app with API credentials.</p>
      <div class="poly-section-heading"><h2>Account &amp; risk policy</h2><span data-rh-policy-version></span></div>
      <div class="poly-settings-grid"><label class="field">Agentic account identifier<input name="accountNumber" maxlength="80" autocomplete="off"></label><label class="field">Equity symbols<input name="symbols" placeholder="SPY, AAPL" maxlength="120" required></label>
      <% for (const [key,label,min,max,step] of [['orderBudgetUsd','Maximum order budget ($)',1,10000,1],['maxPositionPercent','Maximum position (%)',0.1,20,0.1],['maxPositions','Maximum open positions',1,10,1],['cashBufferPercent','Minimum cash buffer (%)',10,90,1],['dailyLossPercent','Daily equity loss (%)',0.1,5,0.1],['weeklyLossPercent','Weekly equity loss (%)',0.1,10,0.1],['stopLossPercent','Stop loss (%)',1,15,0.1],['maxSpreadPercent','Maximum spread (%)',0.01,1,0.01],['maxEntryGapPercent','Maximum entry gap (%)',0.1,5,0.1],['maxExtensionPercent','20-day extension limit (%)',1,15,0.1],['earningsBlackoutDays','Earnings blackout days',1,10,1],['cycleSeconds','Cycle interval (seconds)',300,3600,1]]) { %><label class="field"><%= label %><input name="<%= key %>" type="number" min="<%= min %>" max="<%= max %>" step="<%= step %>" required></label><% } %></div>
      <div class="poly-section-heading"><h2>Broker evidence mappings</h2><span data-rh-verified>MAPPING UNVERIFIED</span></div>
      <p class="poly-model-note">Match the data returned by your connected broker with the information the strategy needs. Sync the available tools, choose the source for each section, then verify it against a real response.</p>
      <div data-rh-binding-editor></div><button class="btn" type="button" data-rh-binding-add>Add a data source</button>
      <details class="rh-schema-view"><summary>Advanced: import or edit a complete mapping</summary><label class="field">Broker mapping JSON<textarea name="bindings" rows="10" spellcheck="false" maxlength="12000" data-rh-bindings>[]</textarea></label><button class="btn" type="button" data-rh-binding-import>Apply JSON to the editor</button></details>
      <div class="workspace-actions"><button type="submit" class="btn primary" disabled>Save policy</button><button type="button" class="btn" data-rh-action="verify" disabled>Verify broker evidence</button><button type="button" class="btn" data-rh-action="catalog" disabled>Sync tool schemas</button></div>
      <p class="poly-model-note"><%= paperWorkspace ? 'These settings apply only to your equity paper workspace. Connect your broker for current data; this workspace cannot submit real orders.' : 'Policy changes revoke autonomous consent and restart the ten-day verified observation requirement.' %> Missing account, quote, tax-history, earnings, or order evidence pauses new entries.</p>
    </form>
    <details class="rh-schema-view"><summary>Discovered Robinhood tool contracts</summary><pre data-rh-catalog>No tool catalog loaded.</pre></details>
    <details class="rh-schema-view"><summary>Verified financial snapshot</summary><pre data-rh-evidence>No verified financial snapshot.</pre></details>
  </section>
</section>
