<section class="route settings-page" data-route-view data-route-key="<%= page.route.key %>">
  <%- include("../partials/route-head", { page }) %>
  <div class="workspace-tabs" role="tablist" aria-label="Settings sections">
    <% for (const [id,label] of [['profile','Profile & appearance'],['connections','Connections'],['defaults','Research defaults'],['automation','AI access'],['system','Workspace health']]) { %><button type="button" role="tab" id="settings-tab-<%= id %>" aria-controls="settings-<%= id %>" aria-selected="<%= id === 'profile' %>" tabindex="<%= id === 'profile' ? 0 : -1 %>" data-settings-tab="<%= id %>"><%= label %></button><% } %>
  </div>
  <p class="workspace-save-state" data-settings-status role="status">Loading saved settings…</p>
  <section id="settings-profile" role="tabpanel" aria-labelledby="settings-tab-profile" data-settings-panel="profile">
    <div class="settings-intro"><div><span class="experience-eyebrow">MAKE IT YOURS</span><h2>Your workspace, your way.</h2><p>Choose how Synergy looks and where your day starts.</p></div><a class="btn" href="/setup" data-nav-link>Revisit setup ↗</a></div>
    <form data-settings-profile class="settings-defaults-form">
      <section class="settings-form-section"><h2>Profile</h2><div class="settings-fields"><label class="field">Display name<input name="displayName" maxlength="80" autocomplete="nickname" placeholder="What should we call you?" required></label><label class="field">Start page<select name="defaultLanding"><option value="/home">Overview</option><option value="/research">Research desk</option><option value="/practice">Practice lab</option><option value="/live">Live workspace</option></select></label><label class="field">Time zone<input name="timezone" list="settings-timezones" maxlength="80" placeholder="America/Chicago" required><datalist id="settings-timezones"><% for (const zone of ['America/Chicago','America/New_York','America/Los_Angeles','America/Denver','Europe/London','Europe/Paris','Asia/Tokyo','Asia/Singapore','Australia/Sydney','UTC']) { %><option value="<%= zone %>"><% } %></datalist><small>Used for workspace date and time displays.</small></label></div></section>
      <section class="settings-form-section"><h2>Appearance</h2><p>Follow your device, or choose a palette that suits your desk.</p><fieldset class="theme-choices"><legend class="sr-only">Color theme</legend><% for (const [value,label,detail] of [['light','Light','Bright, quiet surfaces'],['dark','Dark','A low-light workspace'],['system','System','Match your device']]) { %><label class="theme-choice"><input type="radio" name="theme" value="<%= value %>"><span class="theme-swatch theme-swatch-<%= value %>" aria-hidden="true"><i></i><i></i><i></i></span><strong><%= label %></strong><small><%= detail %></small></label><% } %></fieldset><div class="settings-fields"><label class="field">Spacing<select name="density"><option value="comfortable">Comfortable</option><option value="compact">Compact</option></select></label><label class="field">Preferred reporting currency<select name="currency"><% for(const value of ['USD','EUR','GBP','CAD','AUD','JPY']) { %><option value="<%= value %>"><%= value %></option><% } %></select><small>Broker values retain their original currency; this preference does not convert balances.</small></label></div><label class="preference-toggle"><input name="reducedMotion" type="checkbox"><span><strong>Reduce motion</strong><small>Keep transitions and page animations to a minimum.</small></span></label></section>
      <section class="settings-form-section"><h2>In-app notifications</h2><p>Choose which workspace updates to surface. Required errors and order confirmations always remain visible.</p><% for (const [key,label,detail] of [['researchCompleted','Research updates','Let me know when research results are ready.'],['orderUpdates','Order activity','Show updates about reviewed broker requests.'],['practiceResults','Practice results','Show paper account updates and completed virtual trades.']]) { %><label class="preference-toggle"><input type="checkbox" name="notification_<%= key %>"><span><strong><%= label %></strong><small><%= detail %></small></span></label><% } %></section>
      <button class="btn btn-solid" type="submit" disabled>Save preferences</button><p data-profile-feedback class="provider-feedback" role="status"></p>
    </form>
  </section>
  <section id="settings-connections" role="tabpanel" aria-labelledby="settings-tab-connections" data-settings-panel="connections">
    <div class="workspace-section-title"><div><h2>AI providers</h2><p>Choose the models your agents can use. Keys are encrypted and saved to your account.</p></div><span data-settings-paid>Checking access…</span></div>
    <div class="provider-grid">
      <% for (const [id,label,mark] of [['gemini','Gemini','G'],['openai','ChatGPT / Codex','O'],['claude','Claude','C'],['grok','Grok','X']]) { %>
      <form class="provider-card" data-provider-form="<%= id %>">
        <div class="provider-card-heading"><span class="provider-mark" aria-hidden="true"><%= mark %></span><h3><%= label %></h3><span class="connection-state" data-provider-state>Checking…</span></div>
        <p class="provider-model" data-provider-model></p>
        <label class="field"><%= label %> API key<input name="apiKey" type="password" maxlength="4096" autocomplete="new-password" spellcheck="false" placeholder="Paste a key to save or replace" required></label>
        <div class="workspace-actions"><button class="btn" type="submit" disabled>Save key</button><button class="text-action" type="button" data-provider-remove disabled>Remove saved key</button></div>
        <p class="provider-feedback" data-provider-feedback role="status">Saving does not make an AI call.</p>
      </form><% } %>
    </div>
    <div class="workspace-section-title"><div><h2>Connected accounts</h2><p>Your brokerage connection stays saved until you disconnect or its authorization expires.</p></div></div>
    <section class="connection-card"><div class="connection-card-heading"><span class="provider-mark" aria-hidden="true">R</span><div><h3>Robinhood</h3><p>Stocks, options, and crypto</p></div><span class="connection-state" data-connection-state>Checking…</span></div><p data-connection-detail>Loading your saved connection…</p><div class="workspace-actions"><button class="btn btn-solid" type="button" data-connection-connect disabled>Connect Robinhood ↗</button><button class="text-action" type="button" data-connection-disconnect disabled>Disconnect</button><a class="btn" href="/accounts" data-nav-link>Open accounts</a></div><p class="provider-feedback" data-connection-feedback role="status"></p></section>
    <section class="connection-card"><div class="connection-card-heading"><span class="provider-mark" aria-hidden="true">P</span><div><h3>Polymarket US</h3><p>Account balances, positions, and open orders</p></div></div><p>Connect your existing account with credentials from the Polymarket US developer portal. Account sync is read-only.</p><a class="btn btn-solid" href="/live/polymarket" data-nav-link>Manage Polymarket US connection ↗</a></section>
    <div class="workspace-section-title"><div><h2>Research data</h2><p>Available sources your agents can use alongside the context you provide.</p></div></div>
    <%- include('../partials/reference-feed', { referenceMode: 'settings' }) %>
    <div class="source-list"><div><strong>Robinhood market data</strong><p>Authenticated, on-demand data from your connected account.</p><a href="/accounts" data-nav-link>Open market tools ↗</a></div><div><strong>Economic calendar</strong><p>Scheduled releases via Economicium. No personal API key is required.</p><a href="/market-news" data-nav-link>Open calendar ↗</a></div><div><strong>Your knowledge & memory</strong><p>Saved playbooks, reviewed research, and journal lessons.</p><a href="/research?view=knowledge" data-nav-link>Manage knowledge ↗</a></div></div>
  </section>
  <section id="settings-automation" role="tabpanel" aria-labelledby="settings-tab-automation" data-settings-panel="automation" hidden>
    <div class="settings-intro"><div><span class="experience-eyebrow">WORK WITH YOUR AI</span><h2>Connect an external assistant.</h2><p>Give Codex, Claude Code, or another agent its own access token. You choose what it can change and can revoke it at any time.</p></div><a class="btn" href="/api/v1/openapi.json" target="_blank" rel="noopener">API reference ↗</a></div>
    <div class="api-quickstart"><strong>API base</strong><code data-api-base>/api/v1</code><p>Send <code>Authorization: Bearer YOUR_TOKEN</code> with each request. Discover available actions at <a href="/api/v1/operations" target="_blank" rel="noopener">/api/v1/operations</a>.</p></div>
    <form class="settings-form-section" data-agent-token-form><h3>Create an access token</h3><div class="settings-fields"><label class="field">Name<input name="name" placeholder="Claude research assistant" maxlength="80" required autocomplete="off"></label><label class="field">Expires in<select name="expiresInDays"><option value="7">7 days</option><option value="30" selected>30 days</option><option value="90">90 days</option></select></label></div><fieldset class="agent-scopes" data-agent-scopes><legend>What can this assistant do?</legend><p>Loading available permissions…</p></fieldset><button class="btn btn-solid" type="submit" disabled>Create token</button><p class="provider-feedback" data-agent-feedback role="status"></p></form>
    <section class="new-token-panel" data-agent-new-token hidden><h3>Copy your token now</h3><p>This token is shown once. Store it in your assistant's secret manager.</p><label class="field">Access token<input readonly data-agent-token-value aria-label="New access token" autocomplete="off" spellcheck="false"></label><div class="workspace-actions"><button class="btn" type="button" data-agent-token-copy>Copy token</button><button class="text-action" type="button" data-agent-token-dismiss>I've saved it</button></div></section>
    <h3>Your access tokens</h3><div class="agent-token-list" data-agent-token-list><p>Open this tab to load your tokens.</p></div>
  </section>
  <section id="settings-defaults" role="tabpanel" aria-labelledby="settings-tab-defaults" data-settings-panel="defaults" hidden>
    <form class="settings-defaults-form" data-settings-defaults>
      <section class="settings-form-section"><h2>Research preferences</h2><p>Applied to new research. Your unfinished objective and market context are saved separately.</p><div class="settings-fields"><label class="field">Default provider<select name="provider"><option value="gemini">Gemini</option><option value="openai">ChatGPT / Codex (OpenAI API)</option><option value="claude">Claude</option><option value="grok">Grok</option></select></label><label class="field">Default symbol<input name="symbol" maxlength="24" required></label><label class="field">Timeframe<select name="timeframe"><% for(const value of ['1m','5m','15m','1h','4h','1d']) { %><option value="<%= value %>"><%= value %></option><% } %></select></label></div></section>
      <section class="settings-form-section"><h2>Risk limits</h2><p>Research sizing inputs. They do not change your broker account or grant permission to trade.</p><div class="settings-fields"><label class="field">Account size ($)<input name="accountSize" type="number" min="0.01" max="1000000000" step="0.01" required></label><label class="field">Risk per idea (%)<input name="riskPercent" type="number" min="0.01" max="5" step="0.01" required></label><label class="field">Value per point ($)<input name="pointValue" type="number" min="0.000001" max="1000000" step="any" required></label><label class="field">Minimum reward / risk<input name="minRewardRisk" type="number" min="1" max="20" step="0.1" required></label></div></section>
      <details class="settings-form-section"><summary>Advanced agent routing & budgets</summary><p>Roles inherit your default provider unless you choose another one.</p><div class="settings-fields"><% for(const role of ['planner','researcher','strategist','critic']) { %><label class="field"><%= role %><select name="route_<%= role %>"><option value="">Use default</option><option value="gemini">Gemini</option><option value="openai">ChatGPT / Codex (OpenAI API)</option><option value="claude">Claude</option><option value="grok">Grok</option></select></label><% } %><label class="field">Maximum steps<input name="maxSteps" type="number" min="1" max="24" required></label><label class="field">Maximum model calls<input name="maxModelCalls" type="number" min="1" max="16" required></label><label class="field">Token budget<input name="maxTokens" type="number" min="1000" max="128000" required></label><label class="field">Time limit (seconds)<input name="durationSeconds" type="number" min="1" max="180" required></label><label class="field">Cost cap ($)<input name="maxCostUsd" type="number" min="0.001" max="10" step="0.001" placeholder="Optional"></label></div><p>A cost cap requires configured provider pricing. Server limits still apply.</p></details>
      <button class="btn btn-solid" type="submit" disabled>Save defaults</button><span class="provider-feedback" data-defaults-feedback role="status"></span>
    </form>
  </section>
  <section id="settings-system" role="tabpanel" aria-labelledby="settings-tab-system" data-settings-panel="system" hidden>
    <div class="workspace-storage"><h2>Workspace storage</h2><p data-settings-storage>Checking persistence…</p><p>Sign-in lasts up to 30 days of inactivity. Signing out ends this session; saved research, drafts, and connections remain in your account.</p></div>
    <%- include("../partials/setup-checks") %>
    <% if (page.operator?.capabilities?.includes('admin')) { %><a class="btn" href="/admin" data-nav-link>Administration ↗</a><% } %>
  </section>
</section>
