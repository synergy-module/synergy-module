<!doctype html>
<html lang="en" data-theme="core">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>SYNERGY MODULE Login</title>
    <meta name="description" content="Synergy Module — agentic research, connected accounts, reviewed trading decisions, and a persistent trade journal.">
    <%- include("../partials/redline-head") %>
  </head>
  <body>

    <main id="app" aria-live="polite">
      <section class="login" data-login-root>
        <div class="cortex-login-intro"><a class="cortex-brand" href="/login" aria-label="Synergy Module"><img class="cortex-brand-mark" src="<%= assetPath('/assets/synergy-module-mark.svg') %>" alt="" width="40" height="40"><b class="cortex-brand-name">SYNERGY</b><span>MODULE</span></a><div class="cortex-login-copy"><span class="cortex-eyebrow">AGENTIC TRADING WORKSPACE</span><h1>INTELLIGENCE.<br>WITH INTENT.</h1><p>Your research, reasoning, and execution.<br>One connected command center.</p><img class="cortex-login-art" src="<%= assetPath('/assets/synergy-terminal.png') %>" alt="Synergy Module emblem illuminated in a red terminal grid" width="1536" height="1024" fetchpriority="high"><div class="cortex-login-markets">STOCKS &amp; ETFs <span>◆</span> OPTIONS <span>◆</span> CRYPTO</div></div><span class="cortex-login-footer">SYNERGY MODULE / POWERED BY YOUR PROCESS</span></div>
        <div class="login-card">
          <div class="cortex-theme" role="group" aria-label="Color theme"><button type="button" data-color-theme="core" aria-pressed="true">CORE</button><button type="button" data-color-theme="daylight" aria-pressed="false">DAYLIGHT</button></div><span class="cortex-eyebrow">OPERATOR ACCESS</span><h2>ENTER THE<br>WORKSPACE.</h2><p class="login-sub">Sign in with Discord to access your Synergy Module tools and permissions.</p><% if (typeof designPreview !== 'undefined' && designPreview) { %><p class="cortex-preview">DESIGN PREVIEW · ISOLATED DATA</p><% } %>
          <% if (typeof popupResult !== "undefined") { %>
            <div class="login-form" data-discord-popup-result>
              <div class="login-prompt">&gt; <%= popupResult === "complete" ? "identity confirmed" : "authentication interrupted" %></div>
              <div class="login-fineprint">RETURN TO YOUR TERMINAL. THIS WINDOW WILL CLOSE AUTOMATICALLY.</div>
              <a class="btn btn-primary btn-login" href="/home">[ CONTINUE IN THIS WINDOW ]</a>
            </div>
          <% } else if (complete) { %>
            <div data-auth-complete data-redirect-to="/home"></div>
          <% } else { %>
            <div class="login-form" data-discord-entry>
              <div class="login-prompt">DISCORD SINGLE SIGN-ON</div>
              <div class="login-err" role="alert" <%= authError ? "" : "hidden" %> data-login-error<%= authError ? " data-login-page-error" : "" %>><%= authError ?? "" %></div>
              <a class="btn btn-primary btn-login" href="/auth/discord" data-discord-login>SIGN IN WITH DISCORD ↗</a>
              <div class="login-status" role="status" data-discord-status>Ready when you are.<span class="login-cursor" aria-hidden="true">_</span></div>
              <button class="btn" type="button" data-discord-cancel hidden>[ CANCEL / RETRY ]</button>
              <a class="login-fallback" href="/auth/discord" data-discord-fallback hidden>CONTINUE IN THIS TAB &gt;</a>
              <div class="login-fineprint">Your Discord server roles determine workspace access.</div>
            </div>
          <% } %>
        </div>
      </section>
    </main>

    <noscript><div class="noscript"><strong>SYNERGY MODULE</strong><p>Enable JavaScript to use the trading workspace.</p></div></noscript>

    <script type="module" src="<%= assetPath('/js/login-controller.js') %>"></script>
  </body>
</html>
