{
  "name": "synergy-module",
  "version": "0.1.2",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env --watch src/server.js",
    "start": "node --env-file-if-exists=.env src/server.js",
    "migrate": "node --env-file-if-exists=.env scripts/migrate.js",
    "db:status": "node --env-file-if-exists=.env scripts/migrate.js --status",
    "db:health": "node --env-file-if-exists=.env scripts/database-health.js",
    "db:benchmark": "node scripts/benchmark-database.js",
    "eval:brain": "node scripts/eval-brain.js",
    "test": "node --test",
    "test:watch": "node --test --watch"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.30.1",
    "ajv": "8.20.0",
    "connect-pg-simple": "^10.0.0",
    "ejs": "^3.1.10",
    "express": "^5.2.1",
    "express-session": "^1.19.0",
    "pg": "^8.23.0"
  },
  "devDependencies": {
    "jsdom": "^26.1.0",
    "supertest": "^7.2.2"
  }
}
